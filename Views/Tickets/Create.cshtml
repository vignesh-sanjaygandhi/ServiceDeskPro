@model ServiceDeskPro.Models.Ticket
@{ ViewData["Title"] = "Create Ticket"; }

<div class="container mt-4">
    <h2>Submit a Support Ticket</h2>
    <hr />
    <form method="post" action="/Tickets/Create" class="card p-4 shadow-sm mt-3" style="max-width: 600px;">
        <div class="mb-3">
            <label class="form-label fw-bold">Issue Title</label>
            <input type="text" name="Title" class="form-control" placeholder="e.g., Laptop will not turn on" required />
        </div>
        
        <div class="mb-3">
            <label class="form-label fw-bold">Detailed Description</label>
            <textarea name="Description" class="form-control" rows="4" placeholder="Please describe the issue in detail..." required></textarea>
        </div>
        
        <div class="mb-4">
            <label class="form-label fw-bold">Priority Level</label>
            <select name="Priority" class="form-select">
                <option value="Low">Low</option>
                <option value="Medium">Medium</option>
                <option value="High">High</option>
                <option value="Critical">Critical</option>
            </select>
        </div>
        
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">Submit Ticket</button>
            <a href="/Tickets" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div>